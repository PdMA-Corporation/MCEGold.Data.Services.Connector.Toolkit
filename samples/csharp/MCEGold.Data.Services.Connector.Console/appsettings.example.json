{
  "host": "https://example-isbm-server/isbm/2.0",
  "authenticationScheme": "Basic",
  "apiKey": "<api-key>",
  "userName": "<user-name>",
  "password": "<password>",
  "includeRawResponse": false,
  "publication": {
    "channelId": "/example/publication",
    "subscriptionTopics": [
      "example.topic.1",
      "example.topic.2"
    ]
  },
  "request": {
    "channelId": "/example/request"
  },
  "consoleOutput": {
    "showFullCommandResult": false
  },
  "getSitesRequest": {
    "requestType": "GetSites",
    "payloadProfile": "Full",
    "maxItems": 10,
    "filters": {
      "siteUuid": ""
    }
  },
  "getSegmentsRequest": {
    "requestType": "GetSegments",
    "payloadProfile": "Minimal",
    "maxItems": 10,
    "filters": {
      "siteUuid": "",
      "segmentUuid": "",
      "typeUuid": ""
    }
  },
  "getAssetsRequest": {
    "requestType": "GetAssets",
    "payloadProfile": "Full",
    "maxItems": 10,
    "filters": {
      "assetUuid": "",
      "siteUuid": "",
      "typeUuid": "",
      "serialNumber": ""
    }
  },
  "getMeasurementLocationsRequest": {
    "requestType": "GetMeasurementLocations",
    "payloadProfile": "Full",
    "maxItems": 10,
    "filters": {
      "measurementLocationUuid": "",
      "siteUuid": "",
      "segmentUuid": "",
      "typeUuid": ""
    }
  },
  "getMeasurementsRequest": {
    "requestType": "GetMeasurements",
    "payloadProfile": "Full",
    "maxItems": 100,
    "lastNData": 3,
    "filters": {
      "measurementLocationUuid": "",
      "segmentUuid": "",
      "recordedFrom": "",
      "recordedTo": ""
    }
  },
  "getAssessmentsRequest": {
    "requestType": "GetAssessments",
    "payloadProfile": "Full",
    "maxItems": 100,
    "lastNData": 5,
    "filters": {
      "assetUuid": "",
      "healthLevelTypeUuid": "",
      "assessedFrom": "",
      "assessedTo": "",
      "healthLevelMin": null,
      "healthLevelMax": null
    }
  },
  "getAssetSegmentEventsRequest": {
    "requestType": "GetAssetSegmentEvents",
    "payloadProfile": "Full",
    "maxItems": 100,
    "lastNData": 5,
    "filters": {
      "eventUuid": "",
      "siteUuid": "",
      "segmentUuid": "",
      "assetUuid": "",
      "serialNumber": "",
      "installedNow": null,
      "installedFrom": "",
      "installedTo": "",
      "removedFrom": "",
      "removedTo": ""
    }
  }
}

