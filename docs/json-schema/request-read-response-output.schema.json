{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/mcegold/schemas/request-read-response-output.schema.json",
  "title": "Request Read Response Output",
  "description": "Successful CLI envelope for request read-response.",
  "allOf": [
    { "$ref": "cli-envelope.schema.json" },
    {
      "type": "object",
      "properties": {
        "success": { "const": true },
        "command": { "const": "request.read-response" },
        "data": {
          "type": "object",
          "properties": {
            "statusCode": { "type": "integer" },
            "sessionId": { "type": "string" },
            "requestMessageId": { "type": "string" },
            "responseMessageId": { "type": "string" },
            "payload": {}
          },
          "required": ["statusCode", "sessionId", "requestMessageId", "responseMessageId", "payload"],
          "additionalProperties": false
        },
        "fault": { "type": "null" }
      }
    }
  ]
}
