{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/mcegold/schemas/request/post-request-output.schema.json",
  "title": "Request Post Output",
  "description": "Successful current CLI envelope for staged request post.",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0" },
    "success": { "type": "boolean", "const": true },
    "command": { "type": "string", "const": "request.post" },
    "timestampUtc": { "type": "string", "format": "date-time" },
    "data": {
      "type": "object",
      "properties": {
        "statusCode": { "type": "integer" },
        "sessionId": { "type": "string" },
        "requestType": { "type": "string" },
        "requestMessageId": { "type": "string" }
      },
      "required": ["statusCode", "sessionId", "requestType", "requestMessageId"],
      "additionalProperties": false
    },
    "fault": { "type": "null" },
    "raw": { "$ref": "../common/raw-response.schema.json" }
  },
  "required": ["schemaVersion", "success", "command", "timestampUtc", "data", "fault", "raw"],
  "additionalProperties": false
}
