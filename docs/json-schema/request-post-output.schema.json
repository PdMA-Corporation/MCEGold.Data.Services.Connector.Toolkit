{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/mcegold/schemas/request-post-output.schema.json",
  "title": "Request Post Output",
  "description": "Successful CLI envelope for staged request post.",
  "allOf": [
    { "$ref": "cli-envelope.schema.json" },
    {
      "type": "object",
      "properties": {
        "success": { "const": true },
        "command": { "const": "request.post" },
        "data": {
          "type": "object",
          "properties": {
            "statusCode": { "type": "integer" },
            "sessionId": { "type": "string" },
            "requestType": { "type": "string" },
            "requestMessageId": { "type": "string" }
          },
          "required": ["statusCode", "sessionId", "requestType", "requestMessageId"],
          "additionalProperties": false
        },
        "fault": { "type": "null" }
      }
    }
  ]
}
