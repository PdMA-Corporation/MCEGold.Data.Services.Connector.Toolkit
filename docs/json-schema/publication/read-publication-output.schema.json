{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/mcegold/schemas/publication/read-publication-output.schema.json",
  "title": "Publication Read Output",
  "description": "Successful current CLI envelope for publication read. Current behavior does not emit topics.",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0" },
    "success": { "type": "boolean", "const": true },
    "command": { "type": "string", "const": "publication.read" },
    "timestampUtc": { "type": "string", "format": "date-time" },
    "data": {
      "type": "object",
      "properties": {
        "statusCode": { "type": "integer" },
        "sessionId": { "type": "string" },
        "messageId": { "type": "string" },
        "payload": {}
      },
      "required": ["statusCode", "sessionId", "messageId", "payload"],
      "additionalProperties": false
    },
    "fault": { "type": "null" },
    "raw": { "$ref": "../common/raw-response.schema.json" }
  },
  "required": ["schemaVersion", "success", "command", "timestampUtc", "data", "fault", "raw"],
  "additionalProperties": false
}
