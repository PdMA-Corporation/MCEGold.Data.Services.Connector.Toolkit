{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/mcegold/schemas/publication-close-subscription-output.schema.json",
  "title": "Publication Close Subscription Output",
  "description": "Successful CLI envelope for publication close-subscription.",
  "allOf": [
    { "$ref": "cli-envelope.schema.json" },
    {
      "type": "object",
      "properties": {
        "success": { "const": true },
        "command": { "const": "publication.close-subscription" },
        "data": {
          "type": "object",
          "properties": {
            "statusCode": { "type": "integer" },
            "sessionId": { "type": "string" },
            "closed": { "type": "boolean", "const": true }
          },
          "required": ["statusCode", "sessionId", "closed"],
          "additionalProperties": false
        },
        "fault": { "type": "null" }
      }
    }
  ]
}
