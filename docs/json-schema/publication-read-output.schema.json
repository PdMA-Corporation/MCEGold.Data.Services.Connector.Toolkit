{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/mcegold/schemas/publication-read-output.schema.json",
  "title": "Publication Read Output",
  "description": "Successful CLI envelope for publication read. Current behavior does not emit topics.",
  "allOf": [
    { "$ref": "cli-envelope.schema.json" },
    {
      "type": "object",
      "properties": {
        "success": { "const": true },
        "command": { "const": "publication.read" },
        "data": {
          "type": "object",
          "properties": {
            "statusCode": { "type": "integer" },
            "sessionId": { "type": "string" },
            "messageId": { "type": "string" },
            "payload": {}
          },
          "required": ["statusCode", "sessionId", "messageId", "payload"],
          "additionalProperties": false
        },
        "fault": { "type": "null" }
      }
    }
  ]
}
